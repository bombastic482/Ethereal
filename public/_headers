# Cloudflare Pages / Netlify header rules. Vercel uses vercel.json.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://images.openfoodfacts.org https://*.openfoodfacts.org https://*.goatcounter.com; font-src 'self'; connect-src 'self' https://world.openfoodfacts.org https://*.goatcounter.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=604800
