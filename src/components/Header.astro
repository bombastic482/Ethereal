---
import CommandPalette from '@/components/CommandPalette';
import HeaderCta from '@/components/HeaderCta';
import { withBase } from '@/lib/url';
import { Icon } from '@/components/ui/Icon';
import Logo from '@/components/Logo.astro';
import { NAV, SITE } from '@/lib/site';
import ThemeToggle from './ThemeToggle.astro';
import { getCollection } from 'astro:content';

// Guides are searchable from the quick launcher; only title and path travel to the client.
const guideLinks = (await getCollection('guides', ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .map((g) => ({ label: g.data.title, href: `/guides/${g.id}/`, hint: g.data.category }));

const current = Astro.url.pathname;
const isActive = (href: string) =>
  current === withBase(href) || (href !== '/' && current.startsWith(withBase(href)));
---

<header class="site-header sticky top-0 z-40">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a
      href={withBase('/')}
      class="flex items-center gap-2.5 font-bold tracking-tight"
      aria-label={`${SITE.name} home`}
    >
      <Logo size={32} id="logo-header" />
      <span class="font-display text-xl leading-none">{SITE.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {NAV.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={[
            'rounded-full px-4 py-2 text-sm font-medium transition',
            isActive(item.href) ? 'bg-muted text-fg' : 'text-muted hover:text-fg hover:bg-muted',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
          transition:name={isActive(item.href) ? 'nav-active' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <HeaderCta client:idle />
      <button
        type="button"
        id="palette-btn"
        class="btn btn-ghost hidden h-10 w-10 rounded-full p-0 md:inline-flex"
        aria-label="Quick launcher (⌘K)"
        title="Quick launcher (⌘K)"
      >
        <Icon name="spark" size={18} />
      </button>
      <ThemeToggle />
      <button
        type="button"
        id="nav-toggle"
        class="btn btn-ghost h-10 w-10 rounded-full p-0 md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="container-page hidden pb-4 md:hidden" aria-label="Mobile" hidden>
    <div class="surface grid gap-1 p-2">
      {NAV.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={[
            'rounded-xl px-4 py-3 text-sm font-medium',
            isActive(item.href) ? 'bg-muted' : 'hover:bg-muted',
          ]}
        >
          {item.label}
        </a>
      ))}
      <HeaderCta client:idle compact />
    </div>
  </nav>
  <CommandPalette client:idle guides={guideLinks} />
</header>

<script>
  function bindMenu() {
    const toggle = document.getElementById('nav-toggle');
    const nav = document.getElementById('mobile-nav');
    if (!toggle || !nav || toggle.dataset.bound) return;
    toggle.dataset.bound = '1';
    toggle.addEventListener('click', () => {
      const open = nav.hidden;
      nav.hidden = !open;
      nav.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
  }
  function bindPalette() {
    const b = document.getElementById('palette-btn');
    if (!b || b.dataset.bound) return;
    b.dataset.bound = '1';
    b.addEventListener('click', () => window.dispatchEvent(new Event('ethereal:palette')));
  }
  bindMenu();
  bindPalette();
  document.addEventListener('astro:page-load', () => {
    bindPalette();
    bindMenu();
    // Close the mobile menu after navigating.
    const nav = document.getElementById('mobile-nav');
    const toggle = document.getElementById('nav-toggle');
    if (nav && toggle && !nav.hidden) {
      nav.hidden = true;
      nav.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });
</script>
