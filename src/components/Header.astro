---
import { withBase } from '@/lib/url';
import { Icon } from '@/components/ui/Icon';
import { NAV, SITE } from '@/lib/site';
import ThemeToggle from './ThemeToggle.astro';

const current = Astro.url.pathname;
const isActive = (href: string) =>
  current === withBase(href) || (href !== '/' && current.startsWith(withBase(href)));
---

<header
  class="sticky top-0 z-40 backdrop-blur-md"
  style="background: color-mix(in oklab, var(--bg) 80%, transparent); border-bottom: 1px solid var(--border);"
>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a
      href={withBase('/')}
      class="flex items-center gap-2.5 font-bold tracking-tight"
      aria-label={`${SITE.name} home`}
    >
      <span class="from-brand-500 to-accent-500 shadow-glow grid h-8 w-8 place-items-center rounded-xl bg-gradient-to-br text-white">
        <Icon name="spark" size={18} />
      </span>
      <span class="text-lg">{SITE.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {NAV.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={[
            'rounded-full px-4 py-2 text-sm font-medium transition',
            isActive(item.href) ? 'bg-muted text-fg' : 'text-muted hover:text-fg hover:bg-muted',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={withBase('/tools/calories/')}
        class="btn btn-primary hidden h-10 px-4 text-sm sm:inline-flex"
      >
        Start free
        <Icon name="arrow" size={16} />
      </a>
      <ThemeToggle />
      <button
        type="button"
        id="nav-toggle"
        class="btn btn-ghost h-10 w-10 rounded-full p-0 md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="container-page hidden pb-4 md:hidden" aria-label="Mobile" hidden>
    <div class="surface grid gap-1 p-2">
      {NAV.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={[
            'rounded-xl px-4 py-3 text-sm font-medium',
            isActive(item.href) ? 'bg-muted' : 'hover:bg-muted',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a href={withBase('/tools/calories/')} class="btn btn-primary mt-1">
        Start with the calorie calculator
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = nav!.hidden;
    nav!.hidden = !open;
    nav!.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
