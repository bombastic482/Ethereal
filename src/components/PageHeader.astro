---
/**
 * The top of every app page: the section's icon in its colour, the title and one line on what
 * the page is for. Section pages show their siblings as a switcher underneath.
 */
import { Icon } from '@/components/ui/Icon';
import SectionNav from '@/components/SectionNav.astro';
import { SECTIONS, type Section } from '@/lib/site';

interface Props {
  section: Section;
  heading: string;
  lede: string;
  path: string;
  /** Visually hidden title, for pages that draw their own heading. */
  bare?: boolean;
}
const { section, heading, lede, path, bare = false } = Astro.props;
const s = SECTIONS[section];
---

{bare ? (
  <>
    <h1 class="sr-only">{heading}</h1>
    <SectionNav section={section} path={path} class="mb-6" />
  </>
) : (
  <header class="page-head">
    <div class="flex items-start gap-4">
      <span class="page-icon" aria-hidden="true">
        <Icon name={s.icon} size={24} />
      </span>
      <div class="min-w-0">
        {heading !== s.label && <p class="eyebrow mb-1">{s.label}</p>}
        <h1 class="page-title">{heading}</h1>
        <p class="page-lede">{lede}</p>
      </div>
    </div>
    <SectionNav section={section} path={path} class="mt-6" />
  </header>
)}
