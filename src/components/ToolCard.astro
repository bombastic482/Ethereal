---
import { withBase } from '@/lib/url';
import { Icon } from '@/components/ui/Icon';
import type { ToolMeta } from '@/lib/tools';

interface Props {
  tool: ToolMeta;
  featured?: boolean;
}
const { tool, featured = false } = Astro.props;
---

<a
  href={withBase(`/tools/${tool.slug}/`)}
  class:list={[
    'surface group relative flex flex-col gap-3 p-5 transition duration-200 hover:-translate-y-0.5 hover:shadow-glow',
    featured && 'sm:p-6',
  ]}
>
  <span class="bg-brand-100 text-brand-700 dark:bg-brand-400/15 dark:text-brand-200 grid h-11 w-11 place-items-center rounded-2xl">
    <Icon name={tool.icon} size={22} />
  </span>
  <div>
    <h3 class="text-base font-bold tracking-tight">{tool.name}</h3>
    <p class="text-muted mt-1 text-sm leading-relaxed">
      {featured ? tool.description : tool.short}
    </p>
  </div>
  <span class="text-brand-600 dark:text-brand-300 mt-auto flex items-center gap-1 text-sm font-semibold">
    Open <Icon name="arrow" size={16} class="transition group-hover:translate-x-0.5" />
  </span>
</a>
