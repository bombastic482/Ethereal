---
/**
 * First-run tour, server-rendered and driven by a few lines of inline script so it paints with
 * the page (no island, no hydration wait). Shown once; Settings can replay it by clearing the key.
 */
import { Icon, type IconName } from '@/components/ui/Icon';
import { withBase } from '@/lib/url';

const STEPS: Array<{ icon: IconName; title: string; text: string }> = [
  {
    icon: 'flame',
    title: 'Log in seconds',
    text: 'Type what you ate in plain words, scan a barcode, or search 1,400+ foods that work offline. The ring shows what is left.',
  },
  {
    icon: 'egg',
    title: 'Never wonder what to cook',
    text: '66 recipes built from the same database. Today suggests one that fits what you have left, and the planner builds a whole day or week that lands on your numbers, shopping list included.',
  },
  {
    icon: 'scale',
    title: 'Weigh in, ignore the noise',
    text: 'Daily weigh-ins are smoothed into a trend. A salty dinner will never look like failure again.',
  },
  {
    icon: 'target',
    title: 'Every two weeks, a decision',
    text: 'Ethereal compares your real trend with the plan and tells you the exact calorie change, capped and safe. On Sundays, the weekly review does it in five minutes.',
  },
];
---

<div
  id="tour"
  class="fixed inset-0 z-50 grid place-items-end bg-black/30 p-3 backdrop-blur-sm sm:place-items-center"
  role="dialog"
  aria-modal="true"
  aria-labelledby="tour-title"
  hidden
  data-steps={STEPS.length}
>
  <div
    class="tour-panel bg-elevated w-full max-w-md rounded-3xl p-6 shadow-2xl"
    tabindex="-1"
    data-panel
  >
    <div class="flex items-center justify-between">
      <span class="bg-brand-100 text-brand-700 dark:bg-brand-400/15 dark:text-brand-200 grid h-11 w-11 place-items-center rounded-2xl">
        {STEPS.map((s, i) => (
          <span data-step={i} hidden={i !== 0}>
            <Icon name={s.icon} size={22} />
          </span>
        ))}
      </span>
      <button
        type="button"
        class="btn btn-ghost h-9 w-9 rounded-full p-0"
        data-close
        aria-label="Skip tour"
      >
        <Icon name="close" size={18} />
      </button>
    </div>
    {STEPS.map((s, i) => (
      <div data-step={i} hidden={i !== 0}>
        <h2
          id={i === 0 ? 'tour-title' : undefined}
          class="font-display mt-4 text-3xl tracking-tight"
        >
          {s.title}
        </h2>
        <p class="text-muted mt-2 leading-relaxed">{s.text}</p>
      </div>
    ))}
    <div class="mt-6 flex items-center justify-between">
      <div class="flex gap-1.5" aria-hidden="true" data-dots>
        {STEPS.map((_, k) => (
          <span
            class={`h-1.5 rounded-full transition-all ${k === 0 ? 'bg-brand-600 w-6' : 'bg-muted w-1.5'}`}
          />
        ))}
      </div>
      <div class="flex gap-2">
        <button type="button" class="btn btn-primary" data-next>
          Next <Icon name="arrow" size={16} />
        </button>
        <a href={withBase('/start/')} class="btn btn-primary" data-finish hidden>
          Build my plan <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // Show the tour on first paint for new visitors instead of waiting for the script bundle
  // below, which only wires up its buttons. Moving it onto <body> keeps it above the header.
  (function () {
    try {
      if (localStorage.getItem('ethereal:tour:v1')) return;
    } catch (e) {
      return;
    }
    var root = document.getElementById('tour');
    if (!root) return;
    document.body.appendChild(root);
    root.hidden = false;
    document.body.style.overflow = 'hidden';
  })();
</script>
<script>
  const KEY = 'ethereal:tour:v1';
  function bind() {
    const root = document.getElementById('tour');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    // Page regions carry a view-transition-name and so form stacking contexts; move the overlay
    // onto <body> so it paints above the header and tab bar (same reason the islands use Layer).
    // Re-inserting a node counts as a fresh paint, so only move it if the inline script did not.
    if (root.parentElement !== document.body) document.body.appendChild(root);
    let seen = true;
    try {
      seen = !!localStorage.getItem(KEY);
    } catch {
      /* ignore */
    }
    if (seen) return;
    const n = Number(root.dataset.steps ?? '0');
    let i = 0;
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const dots = [...(root.querySelector('[data-dots]')?.children ?? [])] as HTMLElement[];
    const next = root.querySelector<HTMLElement>('[data-next]')!;
    const finish = root.querySelector<HTMLElement>('[data-finish]')!;
    const show = () => {
      steps.forEach((el) => (el.hidden = Number(el.dataset.step) !== i));
      dots.forEach((d, k) => {
        d.className = `h-1.5 rounded-full transition-all ${k === i ? 'bg-brand-600 w-6' : 'bg-muted w-1.5'}`;
      });
      next.hidden = i >= n - 1;
      finish.hidden = i < n - 1;
      root.querySelectorAll('h2').forEach((h) => h.removeAttribute('id'));
      steps
        .find((el) => Number(el.dataset.step) === i && el.querySelector('h2'))
        ?.querySelector('h2')
        ?.setAttribute('id', 'tour-title');
    };
    const opener = document.activeElement as HTMLElement | null;
    const close = () => {
      try {
        localStorage.setItem(KEY, '1');
      } catch {
        /* ignore */
      }
      root.hidden = true;
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      opener?.focus?.();
    };
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') close();
    };
    next.addEventListener('click', () => {
      i = Math.min(n - 1, i + 1);
      show();
    });
    finish.addEventListener('click', close);
    root.querySelector('[data-close]')?.addEventListener('click', close);
    root.addEventListener('click', (e) => {
      if (e.target === root) close();
    });
    document.addEventListener('keydown', onKey);
    show();
    root.hidden = false;
    document.body.style.overflow = 'hidden';
    root.querySelector<HTMLElement>('[data-panel]')?.focus();
  }
  bind();
  document.addEventListener('astro:page-load', bind);
</script>

<style>
  /* The tour is the first thing a new visitor sees, so it must count as painted at once: it
     rises in with a transform and starts mostly opaque (an entrance from opacity 0 would hold
     back the page's largest-paint time until the animation ends). */
  .tour-panel {
    animation: tour-in 0.42s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }
  @keyframes tour-in {
    from {
      opacity: 0.6;
      transform: translateY(18px) scale(0.98);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tour-panel {
      animation: none;
    }
  }
</style>
