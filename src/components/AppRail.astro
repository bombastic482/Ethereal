---
/**
 * The app's side rail on tablets and desktops: one entry per section, the current one lit in its
 * colour. On wide screens the current section's pages are listed beneath it, so the whole app is
 * one glance away. Phones use the tab bar instead.
 */
import { Icon } from '@/components/ui/Icon';
import { SECTIONS, type Section } from '@/lib/site';
import { withBase } from '@/lib/url';

interface Props {
  section: Section;
  path: string;
}
const { section, path } = Astro.props;
const active = (href: string) =>
  SECTIONS[section].pages
    .filter((p) => path.startsWith(p.href))
    .sort((a, b) => b.href.length - a.href.length)[0]?.href === href;
---

<nav class="rail" aria-label="App">
  <ul class="rail-list">
    {(Object.entries(SECTIONS) as [Section, (typeof SECTIONS)[Section]][]).map(([key, s]) => (
      <li>
        <a
          href={withBase(s.pages[0]!.href)}
          class:list={['rail-item', key === section && 'rail-on']}
          aria-current={key === section ? 'true' : undefined}
          data-astro-prefetch="hover"
          data-section-link={key}
        >
          <span class="rail-icon">
            <Icon name={s.icon} size={20} />
          </span>
          <span class="rail-label">{s.label}</span>
        </a>
        {key === section && s.pages.length > 1 && (
          <ul class="rail-sub" aria-label={`${s.label} pages`}>
            {s.pages.map((p) => (
              <li>
                <a
                  href={withBase(p.href)}
                  class:list={['rail-subitem', active(p.href) && 'rail-sub-on']}
                  aria-current={active(p.href) ? 'page' : undefined}
                >
                  {p.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
  <ul class="rail-list rail-extra">
    <li>
      <a href={withBase('/guides/')} class="rail-item rail-quiet">
        <span class="rail-icon">
          <Icon name="book" size={18} />
        </span>
        <span class="rail-label">Guides</span>
      </a>
    </li>
    <li>
      <a href={withBase('/tools/')} class="rail-item rail-quiet">
        <span class="rail-icon">
          <Icon name="pie" size={18} />
        </span>
        <span class="rail-label">Tools</span>
      </a>
    </li>
  </ul>
</nav>
