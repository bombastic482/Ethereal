---
/**
 * The app's side rail on tablets and desktops, on every page, so the frame never changes as you
 * move around: one entry per section, the current one lit in its colour, with Guides and Tools
 * below. On wide screens the current section's pages are listed beneath it. Phones use the tab
 * bar instead.
 */
import Logo from '@/components/Logo.astro';
import { Icon } from '@/components/ui/Icon';
import { SECTIONS, SITE, type Section } from '@/lib/site';
import { withBase } from '@/lib/url';

interface Props {
  /** The section the page belongs to, if any. */
  section?: Section | undefined;
  /** The page's path without the base, e.g. "/guides/protein/". */
  path: string;
}
const { section, path } = Astro.props;
const EXTRAS = [
  { href: '/guides/', label: 'Guides', icon: 'book' },
  { href: '/tools/', label: 'Tools', icon: 'pie' },
] as const;
const active = (href: string) =>
  section !== undefined &&
  SECTIONS[section].pages
    .filter((p) => path.startsWith(p.href))
    .sort((a, b) => b.href.length - a.href.length)[0]?.href === href;
---

<nav class="rail" aria-label="App" transition:name="rail" transition:animate="none">
  <a href={withBase('/')} class="rail-brand" aria-label={`${SITE.name} home`}>
    <Logo size={34} id="logo-rail" />
    <span class="rail-brand-word">{SITE.name}</span>
  </a>
  <ul class="rail-list">
    {(Object.entries(SECTIONS) as [Section, (typeof SECTIONS)[Section]][]).map(([key, s]) => (
      <li>
        <a
          href={withBase(s.pages[0]!.href)}
          class:list={['rail-item', key === section && 'rail-on']}
          aria-current={key === section ? 'true' : undefined}
          data-astro-prefetch="hover"
          data-section-link={key}
        >
          <span class="rail-icon">
            <Icon name={s.icon} size={20} />
          </span>
          <span class="rail-label">{s.label}</span>
        </a>
        {key === section && s.pages.length > 1 && (
          <ul class="rail-sub" aria-label={`${s.label} pages`}>
            {s.pages.map((p) => (
              <li>
                <a
                  href={withBase(p.href)}
                  class:list={['rail-subitem', active(p.href) && 'rail-sub-on']}
                  aria-current={active(p.href) ? 'page' : undefined}
                >
                  {p.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
  <ul class="rail-list rail-extra">
    {EXTRAS.map((x) => {
      const on = path.startsWith(x.href);
      return (
        <li>
          <a
            href={withBase(x.href)}
            class:list={['rail-item rail-quiet', on && 'rail-on']}
            aria-current={on ? 'page' : undefined}
            data-astro-prefetch="hover"
          >
            <span class="rail-icon">
              <Icon name={x.icon} size={18} />
            </span>
            <span class="rail-label">{x.label}</span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>
