---
/**
 * Phone tab bar. It persists across client-side navigations (it is never re-rendered or
 * cross-faded with the page), and a single highlight slides to the tapped tab the moment it is
 * pressed, before the next page has even loaded; each page is prefetched as a finger touches its
 * tab. Hidden from md up, where the header nav takes over.
 */
import { Icon } from '@/components/ui/Icon';
import { withBase } from '@/lib/url';

const current = Astro.url.pathname;
const tabs = [
  { href: '/today/', label: 'Today', icon: 'flame' },
  { href: '/plan/', label: 'Plan', icon: 'target' },
  { href: '/track/', label: 'Track', icon: 'scale' },
  { href: '/tools/', label: 'Tools', icon: 'pie' },
  { href: '/settings/', label: 'Settings', icon: 'shield' },
] as const;
const activeIndex = tabs.findIndex((tab) => current.startsWith(withBase(tab.href)));
---

<nav
  class="tabbar md:hidden"
  aria-label="App"
  data-tabbar
  transition:persist="tabbar"
  transition:name="tabbar"
  transition:animate="none"
>
  <div class="tabs" style={`--i:${Math.max(0, activeIndex)}`} data-active={activeIndex}>
    <span class="pill" aria-hidden="true"></span>
    {tabs.map((tab, i) => (
      <a
        href={withBase(tab.href)}
        class:list={['tab', i === activeIndex && 'tab-active']}
        aria-current={i === activeIndex ? 'page' : undefined}
        data-tab={i}
        data-path={withBase(tab.href)}
        data-astro-prefetch="tap"
      >
        <Icon name={tab.icon} size={22} />
        <span>{tab.label}</span>
      </a>
    ))}
  </div>
</nav>

<script>
  // The bar is persisted, so its active state is driven here rather than by the server render.
  function setActive(bar: HTMLElement, index: number) {
    const tabs = bar.querySelector<HTMLElement>('.tabs');
    if (!tabs) return;
    if (index >= 0) tabs.style.setProperty('--i', String(index));
    tabs.dataset.active = String(index);
    bar.querySelectorAll<HTMLAnchorElement>('[data-tab]').forEach((a) => {
      const on = Number(a.dataset.tab) === index;
      a.classList.toggle('tab-active', on);
      if (on) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  }
  function sync() {
    const bar = document.querySelector<HTMLElement>('[data-tabbar]');
    if (!bar) return;
    const path = location.pathname;
    const match = [...bar.querySelectorAll<HTMLAnchorElement>('[data-tab]')].find((a) =>
      path.startsWith(a.dataset.path ?? '\u0000'),
    );
    setActive(bar, match ? Number(match.dataset.tab) : -1);
    if (bar.dataset.bound) return;
    bar.dataset.bound = '1';
    // Move the highlight on press, not after the next page arrives, so taps feel instant.
    bar.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('[data-tab]');
      if (a) setActive(bar, Number(a.dataset.tab));
    });
  }
  sync();
  document.addEventListener('astro:page-load', sync);
</script>

<style>
  .tabbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    padding: 0.35rem 0.5rem calc(0.35rem + env(safe-area-inset-bottom, 0px));
    background: color-mix(in oklab, var(--bg-elevated) 88%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-top: 1px solid var(--border);
    /* Its own compositor layer: scrolling the page never repaints the bar. */
    transform: translateZ(0);
    contain: layout paint;
  }
  /* Phones: a live blur behind a fixed bar is the costliest thing Safari can repaint while
     scrolling, and it made the bar stutter. A solid surface keeps the bar crisp and cheap to draw. */
  @media (hover: none) {
    .tabbar {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: var(--bg-elevated);
    }
  }
  @media (min-width: 768px) {
    .tabbar {
      display: none;
    }
  }
  .tabs {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }
  .pill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 20%;
    border-radius: 0.9rem;
    background: var(--color-brand-100);
    transform: translateX(calc(var(--i, 0) * 100%));
    transition:
      transform 0.38s cubic-bezier(0.34, 1.3, 0.64, 1),
      opacity 0.2s ease;
    will-change: transform;
  }
  .tabs[data-active='-1'] .pill {
    opacity: 0;
  }
  :global([data-theme='dark']) .pill {
    background: oklch(64% 0.15 170 / 0.15);
  }
  .tab {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    min-height: 3rem;
    padding: 0.4rem 0.25rem;
    border-radius: 0.9rem;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--fg-subtle);
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    user-select: none;
    transition:
      transform 0.18s cubic-bezier(0.34, 1.4, 0.64, 1),
      color 0.2s ease;
  }
  .tab:active {
    transform: scale(0.92);
  }
  .tab-active {
    color: var(--color-brand-700);
  }
  .tab-active :global(svg) {
    animation: pop 0.3s cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  :global([data-theme='dark']) .tab-active {
    color: var(--color-brand-200);
  }
  @media (prefers-reduced-motion: reduce) {
    .pill,
    .tab {
      transition: none;
    }
    .tab-active :global(svg) {
      animation: none;
    }
  }
</style>
