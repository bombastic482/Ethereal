---
import { withBase } from '@/lib/url';
import HeroPreview from '@/components/HeroPreview';
import HomeSky from '@/components/home/HomeSky';
import Showcase from '@/components/home/Showcase.astro';
import Faq from '@/components/Faq.astro';
import { Icon } from '@/components/ui/Icon';
import Base from '@/layouts/Base.astro';
import { SITE } from '@/lib/site';
import { TOOLS } from '@/lib/tools';
import { getCollection } from 'astro:content';
import foodsA from '@/data/foods-a.json';
import foodsB from '@/data/foods-b.json';
import foodsC from '@/data/foods-c.json';
import foodsD from '@/data/foods-d.json';
import foodsE from '@/data/foods-e.json';
import foodsF from '@/data/foods-f.json';
import { builtRecipes as recipes } from '@/lib/recipes-build';
import { chains } from '@/lib/chains-build';

const recipeCount = recipes.length;
const featuredRecipes = [
  'smoked-salmon-scrambled-eggs-rye',
  'chicken-shawarma-salad-plate',
  'tofu-coconut-spinach-curry',
]
  .map((id) => recipes.find((r) => r.id === id))
  .filter((r): r is NonNullable<typeof r> => !!r);
const foodCount =
  foodsA.length + foodsB.length + foodsC.length + foodsD.length + foodsE.length + foodsF.length;
// Home page strip: the best pick at five well-known food chains.
const chainPicks = ['Chipotle', "McDonald's", 'KFC', "Nando's", 'Subway']
  .map((n) => chains.find((c) => c.name === n))
  .filter((c): c is NonNullable<typeof c> => !!c)
  .map((c) => ({
    chain: c.name,
    slug: c.slug,
    item: c.items[0]!,
  }));
const chainItems = chains.reduce((n, c) => n + c.items.length, 0);
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
// Built as one string so the commas sit flush against the links.
const picksHtml = chainPicks
  .map(
    (p, i) =>
      `<a class="text-fg font-semibold hover:underline" href="${withBase(`/eating-out/#${p.slug}`)}">${esc(p.item.name)}</a> at ${esc(p.chain)} (${p.item.kcal} kcal, ${p.item.protein} g protein)${i < chainPicks.length - 1 ? ', ' : '.'}`,
  )
  .join('');
const guideCount = (await getCollection('guides', ({ data }) => !data.draft)).length;

const tools = [...TOOLS].sort((a, b) => a.order - b.order);
const guides = (await getCollection('guides', ({ data }) => !data.draft))
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  )
  .slice(0, 3);

const faq = [
  {
    q: 'Is Ethereal really free?',
    a: 'Yes. No account, no paywall, no "premium" tier. The site is static and runs entirely in your browser, which costs almost nothing to host.',
  },
  {
    q: 'Where does my data go?',
    a: 'Nowhere. Your stats are saved in your own browser so you only type them once. There are no cookies, no trackers and no server that ever sees them; the site only counts page views, anonymously.',
  },
  {
    q: 'How accurate are the calculators?',
    a: 'They use the equations recommended in clinical nutrition (Mifflin-St Jeor, the U.S. Navy body-fat method, protein ranges from recent meta-analyses). All estimates carry about ±10% error, so treat them as a starting point and adjust from real-world results.',
  },
  {
    q: 'Can I use this to gain weight or maintain?',
    a: 'Yes. The calorie, macro, protein and timeline tools all support maintenance and muscle-gain goals with sensible surplus limits, and the two-week check gives advice in the right direction for each.',
  },
  {
    q: 'I already use MyFitnessPal or Lose It!. Can I bring my history?',
    a: 'Yes. Export a CSV from your current app and import it under Settings. Your diary, weigh-ins and the trend pick up where you left off, and nothing is uploaded: the file is read in your browser.',
  },
  {
    q: 'Does it work offline and on my phone?',
    a: 'Yes. Install it from the browser menu like an app. The food database, recipes, planner and your diary all work without a connection; only barcode lookups for packaged products need the network.',
  },
];
---

<Base title={SITE.name} description={SITE.description} path="/">
  <section class="home-hero">
    <div class="home-hero-sky" aria-hidden="true">
      <HomeSky client:load />
    </div>
    <div class="container-page pt-14 pb-28 sm:pt-20 sm:pb-40">
      <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
        <div class="max-w-2xl text-center lg:text-left">
          <h1 class="home-title">
            Become who you’re <span class="home-title-soft">working toward.</span>
          </h1>
          <p class="home-lede">
            A calm coach for your whole self: home workouts that grow with you, food that fits your
            day, and a clear next step every morning. No gym, no sign-up, and nothing leaves your
            device.
          </p>
          <div class="mt-9 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
            <a href={withBase('/start/')} class="btn home-cta h-12 px-6 text-base">
              Build my plan <Icon name="arrow" size={18} />
            </a>
            <a href={withBase('/train/')} class="btn home-cta-quiet h-12 px-6 text-base">
              <Icon name="dumbbell" size={18} /> Start training
            </a>
          </div>
          <p class="home-note">Two minutes. No account. Free, and it stays that way.</p>
        </div>
        <div class="animate-rise relative [animation-delay:150ms]">
          <HeroPreview client:load />
        </div>
      </div>
    </div>
  </section>

  <Showcase />

  <section class="container-page mt-24" aria-label="By the numbers">
    <div class="border-line grid gap-8 border-y py-10 sm:grid-cols-4">
      {[
        [
          foodCount.toLocaleString('en-US'),
          'curated foods, offline',
          'plus millions of packaged products via Open Food Facts',
        ],
        [String(guideCount), 'evidence-based guides', 'written to be read, not to rank'],
        [
          String(recipeCount),
          'high-protein recipes',
          'built from the database, logged in a tap',
          '/recipes/',
        ],
        ['0', 'trackers, ads, accounts', 'and nothing you type leaves your device'],
      ].map(([n, label, sub, href]) => (
        <div>
          <p class="font-display text-brand-600 dark:text-brand-300 text-4xl leading-none tracking-tight">
            {n}
          </p>
          <p class="mt-2 font-semibold">
            {href ? (
              <a class="hover:text-brand-600 dark:hover:text-brand-300" href={withBase(href)}>
                {label} →
              </a>
            ) : (
              label
            )}
          </p>
          <p class="text-subtle mt-1 text-sm">{sub}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-page mt-24" aria-labelledby="eat">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Food</p>
        <h2 id="eat" class="font-display text-4xl tracking-tight">
          Eat well on a deficit
        </h2>
        <p class="text-muted mt-2">
          {recipes.length} high-protein recipes built from the food database, so what you cook is
          exactly what gets logged. Today picks one that fits what you have left.
        </p>
      </div>
      <a
        href={withBase('/recipes/')}
        class="text-brand-600 dark:text-brand-300 text-sm font-semibold"
      >
        All recipes →
      </a>
    </div>
    <ul class="mt-8 grid gap-4 md:grid-cols-3">
      {featuredRecipes.map((r) => (
        <li class="surface flex flex-col gap-2 p-6">
          <span class="text-subtle text-xs font-semibold">
            {r.meal.charAt(0).toUpperCase() + r.meal.slice(1)} · {r.minutes} min
          </span>
          <a
            class="text-lg font-bold tracking-tight hover:underline"
            href={withBase(`/recipes/${r.id}/`)}
          >
            {r.name}
          </a>
          <span class="text-muted text-sm">
            <span class="tabular">{Math.round(r.totals.kcal)}</span> kcal ·{' '}
            <span class="tabular">{Math.round(r.totals.protein)}</span> g protein
          </span>
          <span class="text-subtle line-clamp-2 text-sm leading-relaxed">{r.method}</span>
        </li>
      ))}
    </ul>
    <div class="surface-muted mt-6 grid gap-4 p-5 sm:grid-cols-[auto_1fr_auto] sm:items-center sm:p-6">
      <Icon name="pie" size={28} class="text-brand-600 dark:text-brand-300 hidden sm:block" />
      <div>
        <h3 class="font-bold tracking-tight">Eating out? Order the lean one.</h3>
        <p class="text-muted mt-1 text-sm">
          {chainItems} menu items at {chains.length} chains ranked by protein per calorie. Best
          picks: <Fragment set:html={picksHtml} />
        </p>
      </div>
      <a href={withBase('/eating-out/')} class="btn btn-secondary text-sm">
        All chains <Icon name="arrow" size={16} />
      </a>
    </div>
  </section>

  <section class="container-page mt-24" aria-labelledby="why">
    <div class="surface-muted grid gap-10 p-8 sm:p-12 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow">Why Ethereal</p>
        <h2 id="why" class="font-display text-4xl tracking-tight">
          Why people trust it
        </h2>
        <p class="text-muted mt-4 leading-relaxed">
          Most health apps are lead magnets for a subscription. This one exists to give you the
          right plan and explain the reasoning, then get out of your way.
        </p>
        <a
          class="text-brand-700 dark:text-brand-300 mt-4 inline-flex text-sm font-semibold"
          href={withBase('/compare/')}
        >
          How it compares with MyFitnessPal, Lose It! and MacroFactor →
        </a>
      </div>
      <ul class="grid gap-5 sm:grid-cols-2">
        {[
          [
            'shield',
            'Evidence first',
            'Mifflin-St Jeor, U.S. Navy method, protein ranges from meta-analyses. Sources on every page.',
          ],
          [
            'lock',
            'Private by design',
            'No account, no cookies, only anonymous page counts. Your stats live in your browser only.',
          ],
          [
            'bolt',
            'Instant everywhere',
            'A static site with almost no JavaScript. Loads in well under a second on a phone.',
          ],
          [
            'check',
            'Honest guard rails',
            'Deficits are capped, floors are enforced and the timeline slows down like real life does.',
          ],
        ].map(([icon, title, text]) => (
          <li class="flex gap-3">
            <span class="text-brand-600 dark:text-brand-300 mt-0.5 shrink-0">
              <Icon name={icon as never} size={20} />
            </span>
            <span>
              <span class="block font-semibold">{title}</span>
              <span class="text-muted text-sm leading-relaxed">{text}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container-page mt-24" aria-labelledby="learn">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Guides</p>
        <h2 id="learn" class="font-display text-4xl tracking-tight">
          Understand the why
        </h2>
        <p class="text-muted mt-2">Short, expert guides that make the numbers make sense.</p>
      </div>
      <a
        href={withBase('/guides/')}
        class="text-brand-600 dark:text-brand-300 text-sm font-semibold"
      >
        All guides →
      </a>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {guides.map((g) => (
        <a
          href={withBase(`/guides/${g.id}/`)}
          class="surface hover:shadow-glow flex flex-col gap-2 p-6 transition hover:-translate-y-0.5"
        >
          <span class="text-subtle text-xs font-semibold">{g.data.category}</span>
          <span class="text-lg font-bold tracking-tight">{g.data.title}</span>
          <span class="text-muted line-clamp-3 text-sm leading-relaxed">{g.data.description}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container-page mt-24" aria-labelledby="tools">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Calculators</p>
        <h2 id="tools" class="font-display text-4xl tracking-tight">
          The numbers, on their own
        </h2>
        <p class="text-muted mt-2">
          Every calculator the plan uses, open to anyone. Type your stats once; they all share them.
        </p>
      </div>
      <a
        href={withBase('/tools/')}
        class="text-brand-700 dark:text-brand-300 text-sm font-semibold"
      >
        All tools →
      </a>
    </div>
    <ul class="mt-8 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
      {tools.map((t) => (
        <li>
          <a href={withBase(`/tools/${t.slug}/`)} class="tool-link">
            <span class="tool-link-icon">
              <Icon name={t.icon} size={18} />
            </span>
            <span class="min-w-0">
              <span class="block truncate font-semibold">{t.name}</span>
              <span class="text-subtle block truncate text-xs">{t.short}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <div class="container-page">
    <Faq items={faq} />
  </div>
  <script>
    // Reveal cards as they scroll into view; no-op when motion is reduced.
    function reveal() {
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if (
        !('IntersectionObserver' in window) ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        els.forEach((el) => el.classList.add('is-visible'));
        return;
      }
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach(
            (e) =>
              e.isIntersecting && (e.target.classList.add('is-visible'), io.unobserve(e.target)),
          ),
        { rootMargin: '0px 0px -10% 0px' },
      );
      els.forEach((el) => io.observe(el));
    }
    reveal();
    document.addEventListener('astro:page-load', reveal);
  </script>
</Base>
