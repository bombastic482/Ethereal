---
import { withBase } from '@/lib/url';
import HeroPreview from '@/components/HeroPreview';
import HowItWorks from '@/components/HowItWorks.astro';
import ToolCard from '@/components/ToolCard.astro';
import Faq from '@/components/Faq.astro';
import { Icon } from '@/components/ui/Icon';
import Base from '@/layouts/Base.astro';
import { SITE } from '@/lib/site';
import { TOOLS } from '@/lib/tools';
import { getCollection } from 'astro:content';
import { existsSync } from 'node:fs';
import foodsA from '@/data/foods-a.json';
import foodsB from '@/data/foods-b.json';
import foodsC from '@/data/foods-c.json';
import foodsD from '@/data/foods-d.json';
import foodsE from '@/data/foods-e.json';
import foodsF from '@/data/foods-f.json';
import { builtRecipes as recipes } from '@/lib/recipes-build';

const recipeCount = recipes.length;
const featuredRecipes = [
  'smoked-salmon-scrambled-eggs-rye',
  'chicken-shawarma-salad-plate',
  'tofu-coconut-spinach-curry',
]
  .map((id) => recipes.find((r) => r.id === id))
  .filter((r): r is NonNullable<typeof r> => !!r);
const foodCount =
  foodsA.length + foodsB.length + foodsC.length + foodsD.length + foodsE.length + foodsF.length;
const guideCount = (await getCollection('guides', ({ data }) => !data.draft)).length;

const heroArt = ['hero.webp', 'hero.png', 'hero.jpg'].find((f) =>
  existsSync(new URL(`../../public/art/${f}`, import.meta.url)),
);

const tools = [...TOOLS].sort((a, b) => a.order - b.order);
const featured = tools.filter((t) => t.featured);
const rest = tools.filter((t) => !t.featured);
const guides = (await getCollection('guides', ({ data }) => !data.draft))
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  )
  .slice(0, 3);

const faq = [
  {
    q: 'Is Ethereal really free?',
    a: 'Yes. No account, no paywall, no "premium" tier. The site is static and runs entirely in your browser, which costs almost nothing to host.',
  },
  {
    q: 'Where does my data go?',
    a: 'Nowhere. Your stats are saved in your own browser so you only type them once. There are no analytics trackers, no cookies and no server that ever sees them.',
  },
  {
    q: 'How accurate are the calculators?',
    a: 'They use the equations recommended in clinical nutrition (Mifflin-St Jeor, the U.S. Navy body-fat method, protein ranges from recent meta-analyses). All estimates carry about ±10% error, so treat them as a starting point and adjust from real-world results.',
  },
  {
    q: 'Can I use this to gain weight or maintain?',
    a: 'Yes. The calorie, macro, protein and timeline tools all support maintenance and muscle-gain goals with sensible surplus limits.',
  },
];

const steps = [
  {
    icon: 'target',
    title: 'Build your plan',
    text: 'Calories, protein, macros and a realistic goal date from your stats.',
    href: '/start/',
  },
  {
    icon: 'scale',
    title: 'Weigh in daily',
    text: 'A smoothed trend line ignores the water noise and shows the truth.',
    href: '/track/',
  },
  {
    icon: 'bolt',
    title: 'Adjust every two weeks',
    text: 'Ethereal compares trend to plan and tells you exactly what to change.',
    href: '/plan/',
  },
] as const;
---

<Base title={SITE.name} description={SITE.description} path="/">
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="bg-brand-300/40 dark:bg-brand-500/20 absolute -top-40 left-1/2 h-[36rem] w-[36rem] -translate-x-1/2 rounded-full blur-3xl"></div>
      <div class="bg-accent-400/30 dark:bg-accent-500/15 absolute top-20 right-[-10rem] h-[24rem] w-[24rem] rounded-full blur-3xl"></div>
    </div>
    <div class="container-page pt-16 pb-12 sm:pt-24 sm:pb-16">
      <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
        <div class="animate-rise max-w-2xl text-center lg:text-left">
          <span class="chip">
            <Icon name="shield" size={14} /> Science-backed · Free forever · No tracking
          </span>
          <h1 class="mt-6 font-display text-6xl leading-[0.92] tracking-tight text-balance sm:text-7xl lg:text-8xl">
            Weight loss, <em class="text-gradient not-italic italic">done properly.</em>
          </h1>
          <p class="text-muted mt-6 max-w-2xl lg:mx-0 text-lg leading-relaxed text-pretty sm:text-xl">
            A personal plan, a weight tracker that sees through the noise, and a two-week check that
            tells you what to change. Built on the equations dietitians use, explained in plain
            English, running privately in your browser.
          </p>
          <div class="mt-9 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
            <a href={withBase('/start/')} class="btn btn-primary h-12 px-6 text-base">
              Build my plan <Icon name="arrow" size={18} />
            </a>
            <a href={withBase('/tools/calories/')} class="btn btn-secondary h-12 px-6 text-base">
              Just the calculators
            </a>
          </div>
          <p class="text-subtle mt-5 text-xs">
            One minute · No account · Your data never leaves your device
          </p>
        </div>
        <div class="animate-rise relative [animation-delay:150ms]">
          {heroArt && (
            <img
              src={withBase(`/art/${heroArt}`)}
              alt=""
              width="1600"
              height="900"
              class="pointer-events-none absolute inset-0 -z-10 h-full w-full scale-125 object-cover opacity-70 blur-[1px]"
              loading="eager"
              fetchpriority="high"
            />
          )}
          <HeroPreview client:visible />
        </div>
      </div>
    </div>
  </section>

  <section class="container-page" aria-labelledby="start">
    <h2 id="start" class="sr-only">
      Start here
    </h2>
    <div class="grid gap-4 md:grid-cols-3">
      {steps.map((s, i) => (
        <a
          href={withBase(s.href)}
          class="surface hover:shadow-glow animate-rise flex gap-4 p-5 transition hover:-translate-y-0.5"
          style={`animation-delay:${120 + i * 60}ms`}
        >
          <span class="bg-brand-100 text-brand-700 dark:bg-brand-400/15 dark:text-brand-200 grid h-11 w-11 shrink-0 place-items-center rounded-2xl">
            <Icon name={s.icon} size={22} />
          </span>
          <span>
            <span class="text-subtle text-xs font-semibold tracking-wide uppercase">
              Step {i + 1}
            </span>
            <span class="block font-bold tracking-tight">{s.title}</span>
            <span class="text-muted block text-sm">{s.text}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <HowItWorks />

  <section class="container-page mt-24" aria-labelledby="features">
    <div class="max-w-2xl">
      <h2 id="features" class="font-display text-4xl tracking-tight">
        Everything the paid apps charge for
      </h2>
      <p class="text-muted mt-2">Free here, with the maths shown.</p>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {[
        [
          'flame',
          'Food diary with barcode scanning',
          'Built-in food database that works offline, Open Food Facts for packaged products, camera scanning, quick add and custom foods.',
        ],
        [
          'target',
          'Adaptive calorie targets',
          'Every two weeks Ethereal compares your real trend with the plan and tells you the exact change, capped and safe.',
        ],
        [
          'scale',
          'A trend that sees through water',
          'Daily weigh-ins are smoothed so a salty dinner never looks like failure.',
        ],
        [
          'calendar',
          'Realistic goal dates',
          'Projections recalculate your maintenance as you get lighter, so the date is one you can plan around.',
        ],
        [
          'spark',
          'Streaks, milestones, weekly report',
          'Small wins made visible: logging streaks, 5% and 5 kg milestones, and a weekly card that tells the truth.',
        ],
        [
          'lock',
          'Private, offline, installable',
          'No account, no cloud. Install it on your phone, use it on a plane, export everything whenever you like.',
        ],
      ].map(([icon, title, text]) => (
        <article class="surface reveal p-6">
          <span class="bg-brand-100 text-brand-700 dark:bg-brand-400/15 dark:text-brand-200 grid h-11 w-11 place-items-center rounded-2xl">
            <Icon name={icon as never} size={22} />
          </span>
          <h3 class="mt-4 font-bold tracking-tight">{title}</h3>
          <p class="text-muted mt-1 text-sm leading-relaxed">{text}</p>
        </article>
      ))}
    </div>
    <p class="text-muted mt-6 text-sm">
      Curious how that stacks up against MyFitnessPal, Lose It! or MacroFactor?{' '}
      <a
        class="text-brand-700 dark:text-brand-300 font-semibold underline"
        href={withBase('/compare/')}
      >
        See the comparison
      </a>
      .
    </p>
  </section>

  <section class="container-page mt-20" aria-labelledby="tools">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="tools" class="font-display text-4xl tracking-tight">
          Every tool you need
        </h2>
        <p class="text-muted mt-2">Eight calculators, one shared profile, zero fluff.</p>
      </div>
      <a
        href={withBase('/tools/')}
        class="text-brand-600 dark:text-brand-300 text-sm font-semibold"
      >
        All tools →
      </a>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {featured.map((t) => (
        <ToolCard tool={t} featured />
      ))}
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {rest.map((t) => (
        <ToolCard tool={t} />
      ))}
    </div>
  </section>

  <section class="container-page mt-24" aria-label="By the numbers">
    <div class="border-line grid gap-8 border-y py-10 sm:grid-cols-4">
      {[
        [
          foodCount.toLocaleString('en-US'),
          'curated foods, offline',
          'plus millions of packaged products via Open Food Facts',
        ],
        [String(guideCount), 'evidence-based guides', 'written to be read, not to rank'],
        [
          String(recipeCount),
          'high-protein recipes',
          'built from the database, logged in a tap',
          '/recipes/',
        ],
        ['0', 'trackers, ads, accounts', 'and nothing you type leaves your device'],
      ].map(([n, label, sub, href]) => (
        <div>
          <p class="font-display text-5xl leading-none tracking-tight">{n}</p>
          <p class="mt-2 font-semibold">
            {href ? (
              <a class="hover:text-brand-600 dark:hover:text-brand-300" href={withBase(href)}>
                {label} →
              </a>
            ) : (
              label
            )}
          </p>
          <p class="text-subtle mt-1 text-sm">{sub}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-page mt-24" aria-labelledby="eat">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="eat" class="font-display text-4xl tracking-tight">
          Eat well on a deficit
        </h2>
        <p class="text-muted mt-2">
          {recipes.length} high-protein recipes built from the food database, so what you cook is
          exactly what gets logged. Today picks one that fits what you have left.
        </p>
      </div>
      <a
        href={withBase('/recipes/')}
        class="text-brand-600 dark:text-brand-300 text-sm font-semibold"
      >
        All recipes →
      </a>
    </div>
    <ul class="mt-8 grid gap-4 md:grid-cols-3">
      {featuredRecipes.map((r) => (
        <li class="surface flex flex-col gap-2 p-6">
          <span class="text-subtle text-xs font-semibold tracking-wide uppercase">
            {r.meal} · {r.minutes} min
          </span>
          <a
            class="text-lg font-bold tracking-tight hover:underline"
            href={withBase(`/recipes/#${r.id}`)}
          >
            {r.name}
          </a>
          <span class="text-muted text-sm">
            <span class="tabular">{Math.round(r.totals.kcal)}</span> kcal ·{' '}
            <span class="tabular">{Math.round(r.totals.protein)}</span> g protein
          </span>
          <span class="text-subtle line-clamp-2 text-sm leading-relaxed">{r.method}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-page mt-24" aria-labelledby="why">
    <div class="surface-muted grid gap-10 p-8 sm:p-12 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 id="why" class="font-display text-4xl tracking-tight">
          Why people trust it
        </h2>
        <p class="text-muted mt-4 leading-relaxed">
          Most calculators are lead magnets for a subscription. This one exists to give you the
          right number and explain the reasoning, then get out of your way.
        </p>
      </div>
      <ul class="grid gap-5 sm:grid-cols-2">
        {[
          [
            'shield',
            'Evidence first',
            'Mifflin-St Jeor, U.S. Navy method, protein ranges from meta-analyses. Sources on every page.',
          ],
          [
            'lock',
            'Private by design',
            'No account, no cookies, no analytics. Your stats live in your browser only.',
          ],
          [
            'bolt',
            'Instant everywhere',
            'A static site with almost no JavaScript. Loads in well under a second on a phone.',
          ],
          [
            'check',
            'Honest guard rails',
            'Deficits are capped, floors are enforced and the timeline slows down like real life does.',
          ],
        ].map(([icon, title, text]) => (
          <li class="flex gap-3">
            <span class="text-brand-600 dark:text-brand-300 mt-0.5 shrink-0">
              <Icon name={icon as never} size={20} />
            </span>
            <span>
              <span class="block font-semibold">{title}</span>
              <span class="text-muted text-sm leading-relaxed">{text}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container-page mt-24" aria-labelledby="learn">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="learn" class="font-display text-4xl tracking-tight">
          Understand the why
        </h2>
        <p class="text-muted mt-2">Short, expert guides that make the numbers make sense.</p>
      </div>
      <a
        href={withBase('/guides/')}
        class="text-brand-600 dark:text-brand-300 text-sm font-semibold"
      >
        All guides →
      </a>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {guides.map((g) => (
        <a
          href={withBase(`/guides/${g.id}/`)}
          class="surface hover:shadow-glow flex flex-col gap-2 p-6 transition hover:-translate-y-0.5"
        >
          <span class="text-subtle text-xs font-semibold tracking-wide uppercase">
            {g.data.category}
          </span>
          <span class="text-lg font-bold tracking-tight">{g.data.title}</span>
          <span class="text-muted line-clamp-3 text-sm leading-relaxed">{g.data.description}</span>
        </a>
      ))}
    </div>
  </section>

  <div class="container-page">
    <Faq items={faq} />
  </div>
  <script>
    // Reveal cards as they scroll into view; no-op when motion is reduced.
    function reveal() {
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if (
        !('IntersectionObserver' in window) ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        els.forEach((el) => el.classList.add('is-visible'));
        return;
      }
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach(
            (e) =>
              e.isIntersecting && (e.target.classList.add('is-visible'), io.unobserve(e.target)),
          ),
        { rootMargin: '0px 0px -10% 0px' },
      );
      els.forEach((el) => io.observe(el));
    }
    reveal();
    document.addEventListener('astro:page-load', reveal);
  </script>
</Base>
