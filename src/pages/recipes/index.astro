---
import { Icon } from '@/components/ui/Icon';
import Base from '@/layouts/Base.astro';
import { absoluteUrl, withBase } from '@/lib/url';
import { builtRecipes as recipes, DIET_LABEL as DIET } from '@/lib/recipes-build';
import type { Recipe } from '@/lib/recipes';

const SECTIONS: Array<{ key: Recipe['meal']; title: string; blurb: string }> = [
  {
    key: 'breakfast',
    title: 'Breakfasts',
    blurb: 'Thirty-plus grams of protein before the day gets busy.',
  },
  { key: 'lunch', title: 'Lunches', blurb: 'Bowls, wraps and salads that hold you until dinner.' },
  {
    key: 'dinner',
    title: 'Dinners',
    blurb: 'Proper plates from around the world, mostly under 650 kcal.',
  },
  { key: 'snack', title: 'Snacks', blurb: 'Ten grams of protein or more, under 250 kcal.' },
];
const site = Astro.site;
const r0 = Math.round;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Ethereal starter recipes',
    numberOfItems: recipes.length,
    itemListElement: recipes.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Recipe',
        name: r.name,
        url: absoluteUrl(`/recipes/${r.id}/`, site),
        recipeCategory: r.meal,
        totalTime: `PT${r.minutes}M`,
        recipeYield: '1 serving',
        recipeIngredient: r.ingredients.map((it) => `${it.grams} g ${it.name}`),
        recipeInstructions: r.method,
        keywords: r.tags.join(', '),
        ...(r.diet === 'vegan' || r.diet === 'vegetarian'
          ? {
              suitableForDiet: `https://schema.org/${r.diet === 'vegan' ? 'Vegan' : 'Vegetarian'}Diet`,
            }
          : {}),
        nutrition: {
          '@type': 'NutritionInformation',
          servingSize: '1 serving',
          calories: `${r0(r.totals.kcal)} kcal`,
          proteinContent: `${r0(r.totals.protein)} g`,
          carbohydrateContent: `${r0(r.totals.carbs)} g`,
          fatContent: `${r0(r.totals.fat)} g`,
          fiberContent: `${r0(r.totals.fibre)} g`,
        },
      },
    })),
  },
];
const vegCount = recipes.filter((r) => r.diet === 'vegan' || r.diet === 'vegetarian').length;
const quickCount = recipes.filter((r) => r.minutes <= 15).length;
---

<Base
  title={`${recipes.length} High-Protein Recipes for Weight Loss`}
  description={`${recipes.length} simple, high-protein recipes with calories and macros computed from the same database as the diary. Every one can be logged in a tap. ${vegCount} vegetarian or vegan, ${quickCount} ready in 15 minutes.`}
  path="/recipes/"
  image="/og/pages/recipes.png"
  jsonLd={jsonLd}
>
  <div class="container-page pt-12 pb-16 sm:pt-16">
    <header class="max-w-2xl">
      <p class="text-brand-700 dark:text-brand-300 text-sm font-semibold tracking-wide uppercase">
        Starter recipes
      </p>
      <h1 class="font-display mt-2 text-4xl leading-[1.05] tracking-tight sm:text-5xl">
        {recipes.length} meals that make a deficit easy
      </h1>
      <p class="text-muted mt-4 text-lg">
        Every recipe is built from foods in the Ethereal database, so the numbers below are exactly
        what lands in your diary. Meals carry at least 25 g of protein, snacks at least 10 g.{' '}
        {vegCount}
        are vegetarian or vegan and {quickCount} take fifteen minutes or less.
      </p>
      <p class="text-muted mt-3 text-sm">
        On{' '}
        <a
          class="text-brand-700 dark:text-brand-300 font-semibold underline underline-offset-2"
          href={withBase('/today/')}
        >
          Today
        </a>
        , open Add → Meals to log any of these in one tap, scale the portion, or save it as your own
        meal and edit it.
      </p>
    </header>

    <div
      class="mt-8 flex flex-wrap items-center gap-2"
      role="group"
      aria-label="Filter recipes"
      data-recipe-filters
    >
      <span class="text-subtle mr-1 text-xs font-semibold tracking-wide uppercase">Show</span>
      {[
        ['all', 'Everything'],
        ['vegetarian', 'Vegetarian'],
        ['vegan', 'Vegan'],
        ['pescatarian', 'Pescatarian'],
      ].map(([v, label]) => (
        <button
          type="button"
          class="chip filter-chip"
          data-diet={v}
          aria-pressed={v === 'all' ? 'true' : 'false'}
        >
          {label}
        </button>
      ))}
      <button type="button" class="chip filter-chip" data-quick aria-pressed="false">
        15 minutes or less
      </button>
      <span class="text-subtle ml-auto text-xs" data-count aria-live="polite"></span>
    </div>
    <p class="text-subtle mt-2 hidden text-xs" data-halal-note>
      Halal filter on: recipes with pork, gelatin or alcohol are hidden.{' '}
      <a class="underline" href={withBase('/settings/')}>
        Change in Settings
      </a>
    </p>

    <nav aria-label="Recipe sections" class="mt-6 flex flex-wrap gap-2">
      {SECTIONS.map((s) => (
        <a class="chip" href={`#${s.key}`}>
          {s.title} · {recipes.filter((r) => r.meal === s.key).length}
        </a>
      ))}
    </nav>

    {SECTIONS.map((s) => {
      const list = recipes.filter((r) => r.meal === s.key);
      return (
        <section id={s.key} class="mt-14 scroll-mt-24" aria-labelledby={`${s.key}-h`}>
          <h2 id={`${s.key}-h`} class="font-display text-3xl tracking-tight sm:text-4xl">
            {s.title}
          </h2>
          <p class="text-muted mt-2">{s.blurb}</p>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2">
            {list.map((r) => (
              <li
                id={r.id}
                class="surface scroll-mt-24 p-5"
                data-diet={r.diet}
                data-minutes={r.minutes}
                data-halal={r.halal ? 'yes' : 'no'}
              >
                <article>
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="text-lg font-bold tracking-tight">
                      <a class="hover:underline" href={withBase(`/recipes/${r.id}/`)}>
                        {r.name}
                      </a>
                    </h3>
                    <span class="text-subtle tabular shrink-0 text-xs">{r.minutes} min</span>
                  </div>
                  <p class="text-subtle mt-1 text-xs">
                    {r0(r.totals.kcal)} kcal · P {r0(r.totals.protein)} g · C {r0(r.totals.carbs)} g
                    · F {r0(r.totals.fat)} g · Fibre {r0(r.totals.fibre)} g
                    {DIET[r.diet] ? ` · ${DIET[r.diet]}` : ''}
                  </p>
                  <ul class="text-muted mt-3 grid gap-1 text-sm">
                    {r.ingredients.map((it) => (
                      <li class="flex justify-between gap-3">
                        <span>{it.name}</span>
                        <span class="tabular text-subtle shrink-0">{it.grams} g</span>
                      </li>
                    ))}
                  </ul>
                  <p class="mt-3 text-sm leading-relaxed">{r.method}</p>
                  <div class="mt-4 flex flex-wrap items-center gap-2">
                    {r.tags.map((t) => (
                      <span class="text-subtle bg-muted rounded-full px-2 py-0.5 text-xs">{t}</span>
                    ))}
                    <a
                      class="btn btn-primary ml-auto h-9 px-3 text-sm"
                      href={withBase(`/today/#recipe=${r.id}`)}
                      aria-label={`Log it: ${r.name}, on Today`}
                    >
                      Log it <Icon name="arrow" size={14} />
                    </a>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        </section>
      );
    })}

    <section class="surface mt-14 p-6 sm:p-8">
      <h2 class="text-xl font-bold tracking-tight">How the numbers are computed</h2>
      <p class="text-muted mt-2 text-sm leading-relaxed">
        Each ingredient is a row in the Ethereal food database with energy and macros per 100 g,
        taken from national composition tables and manufacturer labels. Totals are the ingredient
        sums for one serving, rounded to the nearest kcal and gram. Cooking changes weight, not
        energy, so grams refer to the state named in the ingredient (cooked rice, raw chicken).
        Portion sizes are a starting point: scale them on Today to fit what you have left.
      </p>
    </section>
  </div>
</Base>

<style>
  .filter-chip[aria-pressed='false'] {
    background: var(--bg-muted);
    color: var(--fg-muted);
  }
  .filter-chip:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 2px;
  }
</style>

<script>
  // Progressive enhancement: hide cards that do not match the chosen diet or time. No framework.
  const ORDER = ['vegan', 'vegetarian', 'pescatarian', 'omnivore'];
  function bind() {
    const root = document.querySelector<HTMLElement>('[data-recipe-filters]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    let diet = 'all';
    let quick = false;
    let halal = false;
    try {
      halal = JSON.parse(localStorage.getItem('ethereal:prefs:v1') ?? '{}').halal === true;
    } catch {
      /* ignore */
    }
    document.querySelector<HTMLElement>('[data-halal-note]')?.classList.toggle('hidden', !halal);
    const cards = [...document.querySelectorAll<HTMLElement>('li[data-diet]')];
    const count = root.querySelector<HTMLElement>('[data-count]');
    const apply = () => {
      let shown = 0;
      for (const c of cards) {
        const d = c.dataset.diet ?? 'omnivore';
        // A vegan recipe suits a vegetarian filter; a vegetarian one suits pescatarian.
        const dietOk = diet === 'all' || ORDER.indexOf(d) <= ORDER.indexOf(diet);
        const quickOk = !quick || Number(c.dataset.minutes) <= 15;
        const halalOk = !halal || c.dataset.halal !== 'no';
        const ok = dietOk && quickOk && halalOk;
        c.hidden = !ok;
        if (ok) shown++;
      }
      for (const sec of document.querySelectorAll<HTMLElement>('section[id]')) {
        if (!sec.querySelector('li[data-diet]')) continue;
        sec.hidden = sec.querySelectorAll('li[data-diet]:not([hidden])').length === 0;
      }
      if (count) count.textContent = `${shown} of ${cards.length} recipes`;
    };
    root.querySelectorAll<HTMLButtonElement>('button[data-diet]').forEach((b) =>
      b.addEventListener('click', () => {
        diet = b.dataset.diet ?? 'all';
        root
          .querySelectorAll<HTMLButtonElement>('button[data-diet]')
          .forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        apply();
      }),
    );
    root.querySelector<HTMLButtonElement>('button[data-quick]')?.addEventListener('click', (e) => {
      quick = !quick;
      (e.currentTarget as HTMLButtonElement).setAttribute('aria-pressed', String(quick));
      apply();
    });
    apply();
  }
  bind();
  document.addEventListener('astro:page-load', bind);
</script>
