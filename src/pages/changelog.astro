---
import Base from '@/layouts/Base.astro';
import { withBase } from '@/lib/url';

const entries: Array<{ date: string; title: string; items: string[] }> = [
  {
    date: '2026-10-28',
    title: 'Recipes, planning and switching',
    items: [
      '68 high-protein recipes built from the food database, each with its own page, nutrition table, serving scaler and social card; Today suggests one that fits what you have left.',
      'Plan a day or a whole week that lands on your calorie and protein targets, swap or lock slots, log it in one tap, copy or share the shopping list.',
      'Import your history from MyFitnessPal, Lose It!, Cronometer or any CSV with a preview before anything is written.',
      'Weekly review: twelve-week consistency grid, where the calories went, late-eating and concentration insights, and a shareable week card.',
      'Search puts everyday staples first and understands coke, yoghurt, courgette and other spellings; 1,537 foods including chains and brands.',
      'Six more guides (18 total): weight loss after 40, vegetarian and vegan fat loss, intermittent fasting, GLP-1 medications, exercise snacks, when to stop dieting.',
      'Fixes: saved meals and steps survive a reload, backups carry the whole diary, modals sit above the header on every page, the two-week check works for gain and maintenance goals and no longer stacks adjustments, quick entry understands "half an avocado" and "1 cup oats".',
    ],
  },
  {
    date: '2026-10-27',
    title: 'The diary grows up',
    items: [
      'Natural-language logging ("2 eggs, a slice of toast and 150g greek yogurt"), saved meals, a shareable progress card and calendar reminders.',
      'Measured expenditure from your own intake and trend, pattern insights, steps and body measurements, a first-run tour and a quick launcher (⌘K).',
      'Error boundaries on every screen, print styles, PWA shortcuts, and a weekly review page.',
    ],
  },
  {
    date: '2026-10-26',
    title: 'Launch',
    items: [
      'Eight calculators sharing one profile, a three-step plan, a weight tracker with a smoothed trend and a two-week check, a food diary with barcode scanning and Open Food Facts search.',
      'Static, free to host, no account, no tracking. Lighthouse 95+ on every category, WCAG 2.1 AA checked in CI.',
    ],
  },
];
---

<Base
  title="Changelog"
  description="What changed in Ethereal and when: recipes and planning, importing from other apps, the weekly review, search, guides and fixes."
  path="/changelog/"
>
  <div class="container-page pt-12 pb-16 sm:pt-16">
    <header class="max-w-2xl">
      <h1 class="font-display text-5xl leading-[0.95] tracking-tight sm:text-6xl">What's new</h1>
      <p class="text-muted mt-4 text-lg">
        Ethereal ships often. Everything here is live at the same address; there is nothing to
        update because it is a website. Found a problem?{' '}
        <a
          class="text-brand-700 dark:text-brand-300 font-semibold"
          href="https://github.com/bombastic482/Ethereal/issues"
          rel="noopener"
        >
          tell us on GitHub
        </a>
        .
      </p>
    </header>
    <ol class="mt-12 grid gap-8">
      {entries.map((e) => (
        <li class="surface p-6 sm:p-8">
          <time class="text-subtle text-xs font-semibold tracking-wide uppercase" datetime={e.date}>
            {new Date(e.date + 'T00:00:00').toLocaleDateString('en-US', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })}
          </time>
          <h2 class="font-display mt-2 text-3xl tracking-tight">{e.title}</h2>
          <ul class="text-muted mt-4 grid gap-2 text-sm leading-relaxed">
            {e.items.map((it) => (
              <li class="flex gap-2">
                <span class="text-brand-600 dark:text-brand-300 mt-1.5 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-current" />
                <span>{it}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
    <p class="text-subtle mt-10 text-sm">
      The full history is in the{' '}
      <a
        class="underline"
        href="https://github.com/bombastic482/Ethereal/commits/main"
        rel="noopener"
      >
        commit log
      </a>
      . Methodology and data sources are on the{' '}
      <a class="underline" href={withBase('/about/')}>
        about page
      </a>
      .
    </p>
  </div>
</Base>
