---
import { Icon } from '@/components/ui/Icon';
import Base from '@/layouts/Base.astro';
import { chains } from '@/lib/chains-build';
import { absoluteUrl, withBase } from '@/lib/url';

const total = chains.reduce((s, c) => s + c.items.length, 0);
const site = Astro.site;
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/', site) },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Eating out',
        item: absoluteUrl('/eating-out/', site),
      },
    ],
  },
];
---

<Base
  title={`Eating Out: the Best Picks at ${chains.length} Chains`}
  description={`${total} menu items from ${chains.length} chains ranked by protein per calorie, from published nutrition data. See the leanest order at McDonald's, KFC, Chipotle, Nando's, Starbucks and more, and log it in one tap.`}
  path="/eating-out/"
  image="/og/pages/eating-out.png"
  jsonLd={jsonLd}
>
  <div class="container-page pt-12 pb-16 sm:pt-16">
    <header class="max-w-2xl">
      <p class="text-brand-700 dark:text-brand-300 text-sm font-semibold tracking-wide uppercase">
        Eating out
      </p>
      <h1 class="font-display mt-2 text-5xl leading-[0.95] tracking-tight sm:text-6xl">
        The leanest order at {chains.length} chains
      </h1>
      <p class="text-muted mt-4 text-lg">
        {total} menu items from published nutrition data. Food is ranked by grams of protein per 100
        kcal; coffee-shop drinks by calories, lowest first. Nothing here is off limits; the ranking
        just shows which orders leave the most room in the day. Tap <strong>Log</strong> to add one
        to Today with the right portion.
      </p>
    </header>

    <nav aria-label="Chains" class="mt-8 flex flex-wrap gap-2">
      {chains.map((c) => (
        <a class="chip" href={`#${c.slug}`}>
          {c.name}
        </a>
      ))}
    </nav>

    <div class="mt-12 grid gap-10">
      {chains.map((c) => (
        <section id={c.slug} class="scroll-mt-24" aria-labelledby={`${c.slug}-h`}>
          <div class="flex items-baseline justify-between gap-3">
            <h2 id={`${c.slug}-h`} class="font-display text-3xl tracking-tight">
              {c.name}
            </h2>
            <span class="text-subtle text-xs">
              {c.items.length} items ·{' '}
              {c.kind === 'drinks' ? 'lowest calories first' : 'best first'}
            </span>
          </div>
          <div
            class="surface mt-4 overflow-x-auto"
            tabindex="0"
            role="region"
            aria-label={`${c.name} menu items`}
          >
            <table class="w-full text-sm">
              <thead>
                <tr class="text-subtle text-left text-xs">
                  <th class="px-4 py-3 font-semibold">Item</th>
                  <th class="px-4 py-3 text-right font-semibold">kcal</th>
                  <th class="px-4 py-3 text-right font-semibold">Protein</th>
                  <th class="px-4 py-3 text-right font-semibold">Carbs</th>
                  <th class="px-4 py-3 text-right font-semibold">Fat</th>
                  <th class="px-4 py-3 text-right font-semibold">
                    {c.kind === 'drinks' ? 'kcal / 100 ml' : 'P / 100 kcal'}
                  </th>
                  <th class="hidden px-4 py-3 sm:table-cell" />
                </tr>
              </thead>
              <tbody class="tabular">
                {c.items.map((it, i) => (
                  <tr class="border-line border-t">
                    <td class="px-4 py-2.5">
                      <span class="font-semibold">{it.name}</span>
                      <span class="text-subtle block text-xs">{it.servingLabel}</span>
                      <a
                        class="text-brand-700 dark:text-brand-300 mt-1 inline-block text-xs font-semibold sm:hidden"
                        href={withBase(`/today/#food=${it.id}`)}
                        aria-label={`Log ${it.name} from ${c.name} on Today`}
                      >
                        Log →
                      </a>
                    </td>
                    <td class="px-4 py-2.5 text-right">{it.kcal}</td>
                    <td class="px-4 py-2.5 text-right">{it.protein} g</td>
                    <td class="px-4 py-2.5 text-right">{it.carbs} g</td>
                    <td class="px-4 py-2.5 text-right">{it.fat} g</td>
                    <td
                      class={`px-4 py-2.5 text-right font-semibold ${i === 0 ? 'text-brand-700 dark:text-brand-300' : ''}`}
                    >
                      {c.kind === 'drinks' ? it.kcalPer100ml : it.proteinPer100}
                    </td>
                    <td class="hidden px-2 py-2.5 text-right sm:table-cell">
                      <a
                        class="btn btn-ghost border-line h-8 border px-3 text-xs"
                        href={withBase(`/today/#food=${it.id}`)}
                        aria-label={`Log ${it.name} from ${c.name} on Today`}
                      >
                        Log
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
    </div>

    <section class="surface mt-14 p-6 sm:p-8">
      <h2 class="text-xl font-bold tracking-tight">How to use this</h2>
      <p class="text-muted mt-2 text-sm leading-relaxed">
        Protein per 100 kcal is the quickest way to spot the order that keeps you full for the
        calories: 8 or more is excellent, 4 to 8 is a fair trade, under 4 is mostly fat or sugar.
        Coffee is different: the drink itself is almost free, so the table ranks by calories and
        shows kcal per 100 ml; a grande sweetened drink with cream can carry a meal's worth, while
        an americano or a small flat white costs next to nothing. Values come from the chains'
        published nutrition tables at the time of writing and change with recipes and regions; scan
        the receipt barcode or use the chain's own numbers if yours differ. For a planned night out,
        bank 100 to 150 kcal on the surrounding days rather than skipping meals, and read{' '}
        <a
          class="text-brand-700 dark:text-brand-300 font-semibold"
          href={withBase('/guides/eating-out-and-alcohol/')}
        >
          the guide to eating out and alcohol.
        </a>
      </p>
    </section>
    <p class="mt-6">
      <a class="btn btn-secondary" href={withBase('/recipes/')}>
        <Icon name="egg" size={16} /> Prefer to cook? 68 recipes
      </a>
    </p>
  </div>
</Base>
