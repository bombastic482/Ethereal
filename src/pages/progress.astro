---
import Milestones from '@/components/body/Milestones';
import PlanDashboard from '@/components/calculators/PlanDashboard';
import Rhythm from '@/components/progress/Rhythm';
import AppLayout from '@/layouts/AppLayout.astro';
---

<AppLayout
  title="Progress"
  description="Your daily calorie and protein targets, progress to goal, today's weigh-in and a two-week check that tells you exactly what to change."
  path="/progress/"
  heading="Progress"
  lede="Where you are, how far you've come, and the one thing to change next."
  section="progress"
>
  <PlanDashboard client:load />
  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <Rhythm client:idle />
    <Milestones client:idle />
  </div>
</AppLayout>
