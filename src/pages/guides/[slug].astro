---
import { absoluteUrl, withBase } from '@/lib/url';
import BaseLinks from '@/components/BaseLinks.astro';
import Disclaimer from '@/components/Disclaimer.astro';
import ToolCard from '@/components/ToolCard.astro';
import Base from '@/layouts/Base.astro';
import { readingTime } from '@/lib/reading-time';
import { SITE } from '@/lib/site';
import { toolBySlug } from '@/lib/tools';
import { getCollection, render } from 'astro:content';
import { builtRecipes } from '@/lib/recipes-build';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const path = `/guides/${guide.id}/`;
const site = Astro.site ?? new URL('https://ethereal.pages.dev');
const minutes = readingTime(guide.body ?? '');
const related = guide.data.relatedTools.map(toolBySlug).filter((t) => t !== undefined);
const toc = headings.filter((h) => h.depth === 2);
// Three recipes that fit the article: vegan/vegetarian guides get plant-based ones, protein
// guides the highest-protein, quick-living guides the fastest; otherwise a spread by meal.
const tagText = `${guide.id} ${guide.data.tags.join(' ')} ${guide.data.title}`.toLowerCase();
const pool = /vegan|vegetarian|plant/.test(tagText)
  ? builtRecipes.filter((r) => r.diet === 'vegan' || r.diet === 'vegetarian')
  : builtRecipes;
const ranked = /protein|muscle|strength/.test(tagText)
  ? [...pool].sort((a, b) => b.totals.protein - a.totals.protein)
  : /busy|habit|snack|neat|walking|hunger/.test(tagText)
    ? [...pool].sort((a, b) => a.minutes - b.minutes)
    : [...pool].sort((a, b) => (a.id.charCodeAt(1) % 7) - (b.id.charCodeAt(1) % 7));
const recipePicks: typeof builtRecipes = [];
for (const meal of ['breakfast', 'lunch', 'dinner'] as const) {
  const r = ranked.find((x) => x.meal === meal);
  if (r) recipePicks.push(r);
}
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });

const jsonLd = [
  {
    '@type': 'Article',
    headline: guide.data.title,
    description: guide.data.description,
    datePublished: guide.data.pubDate.toISOString(),
    dateModified: (guide.data.updatedDate ?? guide.data.pubDate).toISOString(),
    author: { '@type': 'Organization', name: SITE.name },
    publisher: { '@id': `${absoluteUrl('/', site)}#org` },
    mainEntityOfPage: absoluteUrl(path, site),
    articleSection: guide.data.category,
    keywords: guide.data.tags.join(', '),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/', site) },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Guides',
        item: absoluteUrl('/guides/', site),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: guide.data.title,
        item: absoluteUrl(path, site),
      },
    ],
  },
];
---

<Base
  title={guide.data.title}
  description={guide.data.description}
  path={path}
  type="article"
  publishedTime={guide.data.pubDate}
  modifiedTime={guide.data.updatedDate}
  jsonLd={jsonLd}
>
  <div class="container-page pt-10 pb-16 sm:pt-14">
    <nav aria-label="Breadcrumb" class="text-subtle mb-6 flex items-center gap-2 text-sm">
      <a class="hover:text-fg" href={withBase('/')}>
        Home
      </a>
      <span aria-hidden="true">/</span>
      <a class="hover:text-fg" href={withBase('/guides/')}>
        Guides
      </a>
      <span aria-hidden="true">/</span>
      <span class="text-fg" aria-current="page">
        {guide.data.category}
      </span>
    </nav>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_16rem]">
      <article class="max-w-3xl">
        <header class="animate-rise">
          <span class="chip">{guide.data.category}</span>
          <h1 class="mt-4 font-display text-5xl leading-[0.95] tracking-tight text-balance sm:text-6xl">
            {guide.data.title}
          </h1>
          <p class="text-muted mt-4 text-lg leading-relaxed">{guide.data.description}</p>
          <p class="text-subtle mt-4 text-sm">
            {minutes} min read · Updated{' '}
            <time datetime={(guide.data.updatedDate ?? guide.data.pubDate).toISOString()}>
              {fmt(guide.data.updatedDate ?? guide.data.pubDate)}
            </time>
          </p>
        </header>
        <div class="prose-ethereal mt-10">
          <BaseLinks>
            <Content />
          </BaseLinks>
        </div>
        {recipePicks.length > 0 && (
          <section class="mt-12" aria-labelledby="recipes-h">
            <div class="flex items-baseline justify-between gap-3">
              <h2 id="recipes-h" class="font-display text-2xl">
                Recipes that fit this article
              </h2>
              <a
                class="text-brand-700 dark:text-brand-300 text-sm font-semibold"
                href={withBase('/recipes/')}
              >
                All {builtRecipes.length} →
              </a>
            </div>
            <ul class="mt-4 grid gap-3 sm:grid-cols-3">
              {recipePicks.map((r) => (
                <li class="surface p-4">
                  <span class="text-subtle text-xs font-semibold tracking-wide uppercase">
                    {r.meal} · {r.minutes} min
                  </span>
                  <a
                    class="mt-1 block font-bold tracking-tight hover:underline"
                    href={withBase(`/recipes/${r.id}/`)}
                  >
                    {r.name}
                  </a>
                  <span class="text-subtle mt-1 block text-xs">
                    {Math.round(r.totals.kcal)} kcal · P {Math.round(r.totals.protein)} g
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}
        <aside class="surface-muted mt-12 grid gap-4 p-6 sm:grid-cols-[1fr_auto] sm:items-center">
          <div>
            <h2 class="font-display text-2xl">Put it into practice</h2>

            <p class="text-muted mt-1 text-sm">
              Reading changes nothing until it meets a plate and a scale. Log today's food, or build
              the plan this article assumes.
            </p>
          </div>

          <div class="flex flex-wrap gap-2">
            <a href={withBase('/today/')} class="btn btn-primary text-sm">
              Log today
            </a>

            <a href={withBase('/start/')} class="btn btn-secondary text-sm">
              Build a plan
            </a>
            <a href={withBase('/recipes/')} class="btn btn-ghost border-line border text-sm">
              Browse {builtRecipes.length} recipes
            </a>
          </div>
        </aside>
        <Disclaimer />
      </article>
      <aside class="hidden lg:block">
        <div class="sticky top-24 grid gap-8">
          {toc.length > 0 && (
            <nav aria-label="On this page">
              <p class="text-subtle mb-3 text-xs font-semibold tracking-wide uppercase">
                On this page
              </p>
              <ol class="border-line grid gap-2 border-l text-sm">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class="text-muted hover:text-fg hover:border-brand-500 -ml-px block border-l border-transparent pl-4 transition"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )}
          {related.length > 0 && (
            <div>
              <p class="text-subtle mb-3 text-xs font-semibold tracking-wide uppercase">
                Try the tools
              </p>
              <div class="grid gap-3">
                {related.map((t) => (
                  <ToolCard tool={t} />
                ))}
              </div>
            </div>
          )}
        </div>
      </aside>
    </div>
  </div>
</Base>
