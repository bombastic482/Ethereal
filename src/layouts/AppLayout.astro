---
import Disclaimer from '@/components/Disclaimer.astro';
import PageHeader from '@/components/PageHeader.astro';
import type { Section } from '@/lib/site';
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  lede: string;
  /** The app section this page lives in; 'start' is first-run setup, outside every section. */
  section: Section | 'start';
  noindex?: boolean;
  /** Hide the heading block, for pages that draw their own. */
  bare?: boolean;
}
const {
  title,
  description,
  path,
  heading,
  lede,
  section,
  noindex = false,
  bare = false,
} = Astro.props;
---

<Base title={title} description={description} path={path} noindex={noindex}>
  <div class="container-page pt-6 pb-16 sm:pt-10">
    {section === 'start' ? (
      <header class="page-head">
        <h1 class="page-title">{heading}</h1>
        <p class="page-lede">{lede}</p>
      </header>
    ) : (
      <PageHeader section={section} heading={heading} lede={lede} path={path} bare={bare} />
    )}
    <div>
      <slot />
    </div>
    <Disclaimer />
  </div>
</Base>
