---
import Disclaimer from '@/components/Disclaimer.astro';
import SectionNav from '@/components/SectionNav.astro';
import type { Section } from '@/lib/site';
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  lede: string;
  /** The app section this page lives in; 'start' is first-run setup, outside every section. */
  section: Section | 'start';
  noindex?: boolean;
  /** Hide the heading block, for pages that draw their own. */
  bare?: boolean;
}
const {
  title,
  description,
  path,
  heading,
  lede,
  section,
  noindex = false,
  bare = false,
} = Astro.props;
---

<Base title={title} description={description} path={path} noindex={noindex}>
  <div class="container-page pt-6 pb-16 sm:pt-10">
    {section !== 'start' && <SectionNav section={section} path={path} class="mb-6 sm:mb-8" />}
    {bare ? (
      <h1 class="sr-only">{heading}</h1>
    ) : (
      <header class="mb-8 max-w-3xl">
        <h1 class="font-display text-4xl leading-[1.05] tracking-tight sm:text-5xl">{heading}</h1>
        <p class="text-muted mt-3 text-lg leading-relaxed">{lede}</p>
      </header>
    )}
    <div>
      <slot />
    </div>
    <Disclaimer />
  </div>
</Base>
