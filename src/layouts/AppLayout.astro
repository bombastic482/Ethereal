---
import Disclaimer from '@/components/Disclaimer.astro';
import { Icon } from '@/components/ui/Icon';
import { withBase } from '@/lib/url';
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  lede: string;
  current: 'today' | 'plan' | 'track' | 'settings' | 'start';
  noindex?: boolean;
}
const { title, description, path, heading, lede, current, noindex = false } = Astro.props;
const tabs = [
  { key: 'today', href: '/today/', label: 'Today', icon: 'flame' },
  { key: 'plan', href: '/plan/', label: 'My plan', icon: 'target' },
  { key: 'track', href: '/track/', label: 'Track', icon: 'scale' },
  { key: 'settings', href: '/settings/', label: 'Settings & data', icon: 'shield' },
] as const;
---

<Base title={title} description={description} path={path} noindex={noindex}>
  <div class="container-page pt-8 pb-16 sm:pt-12">
    {current !== 'start' && (
      <nav
        class="bg-muted mb-8 hidden gap-1 rounded-2xl p-1 md:inline-flex"
        aria-label="App sections"
      >
        {tabs.map((t) => (
          <a
            href={withBase(t.href)}
            class:list={[
              'flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-medium transition',
              t.key === current ? 'bg-elevated text-fg shadow-soft' : 'text-muted hover:text-fg',
            ]}
            aria-current={t.key === current ? 'page' : undefined}
          >
            <Icon name={t.icon} size={16} /> {t.label}
          </a>
        ))}
      </nav>
    )}
    <header class="animate-rise mb-8 max-w-3xl">
      <h1 class="font-display text-5xl leading-[0.95] tracking-tight sm:text-6xl">{heading}</h1>
      <p class="text-muted mt-3 text-lg leading-relaxed">{lede}</p>
    </header>
    <div class="animate-rise [animation-delay:80ms]">
      <slot />
    </div>
    <Disclaimer />
  </div>
</Base>
