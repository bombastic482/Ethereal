---
import { absoluteUrl, withBase } from '@/lib/url';
import Disclaimer from '@/components/Disclaimer.astro';
import Faq, { type FaqItem } from '@/components/Faq.astro';
import ToolCard from '@/components/ToolCard.astro';
import { Icon } from '@/components/ui/Icon';
import { TOOLS, toolBySlug } from '@/lib/tools';
import { getCollection } from 'astro:content';
import Base from './Base.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  /** Short line under the H1. */
  lede: string;
  faq: FaqItem[];
}

const { slug, title, description, lede, faq } = Astro.props;
const tool = toolBySlug(slug);
if (!tool) throw new Error(`Unknown tool: ${slug}`);
const path = `/tools/${slug}/`;
const site = Astro.site ?? new URL('https://ethereal.pages.dev');

const related = TOOLS.filter((t) => t.slug !== slug)
  .sort((a, b) => a.order - b.order)
  .slice(0, 3);
const guides = (
  await getCollection(
    'guides',
    ({ data }) => !data.draft && data.relatedTools.includes(slug as never),
  )
).slice(0, 3);

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: title,
    url: absoluteUrl(path, site),
    description,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isAccessibleForFree: true,
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/', site) },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Tools',
        item: absoluteUrl('/tools/', site),
      },
      { '@type': 'ListItem', position: 3, name: title, item: absoluteUrl(path, site) },
    ],
  },
];
---

<Base title={title} description={description} path={path} jsonLd={jsonLd}>
  <div class="container-page pt-10 pb-16 sm:pt-14">
    <nav aria-label="Breadcrumb" class="text-subtle mb-6 flex items-center gap-2 text-sm">
      <a class="hover:text-fg" href={withBase('/')}>
        Home
      </a>
      <span aria-hidden="true">/</span>
      <a class="hover:text-fg" href={withBase('/tools/')}>
        Tools
      </a>
      <span aria-hidden="true">/</span>
      <span class="text-fg" aria-current="page">
        {tool.short}
      </span>
    </nav>

    <header class="animate-rise mb-8 max-w-3xl">
      <div class="chip mb-4">
        <Icon name={tool.icon} size={14} /> Free · No sign-up · Private
      </div>
      <h1 class="font-display text-5xl leading-[0.95] tracking-tight sm:text-6xl">{title}</h1>
      <p class="text-muted mt-4 text-lg leading-relaxed">{lede}</p>
    </header>

    <div class="animate-rise [animation-delay:80ms]">
      <slot name="calculator" />
    </div>

    <article class="prose-ethereal mt-16 max-w-3xl">
      <slot />
    </article>

    <Faq items={faq} />

    {guides.length > 0 && (
      <section class="mt-16" aria-labelledby="rel-guides">
        <h2 id="rel-guides" class="font-display text-3xl tracking-tight">
          Go deeper
        </h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {guides.map((g) => (
            <a
              href={withBase(`/guides/${g.id}/`)}
              class="surface hover:shadow-glow flex flex-col gap-2 p-5 transition hover:-translate-y-0.5"
            >
              <span class="text-subtle text-xs font-semibold tracking-wide uppercase">
                {g.data.category}
              </span>
              <span class="font-bold tracking-tight">{g.data.title}</span>
              <span class="text-muted line-clamp-3 text-sm">{g.data.description}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="mt-16" aria-labelledby="rel-tools">
      <h2 id="rel-tools" class="font-display text-3xl tracking-tight">
        More tools
      </h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {related.map((t) => (
          <ToolCard tool={t} />
        ))}
      </div>
    </section>

    <Disclaimer />
  </div>
</Base>
