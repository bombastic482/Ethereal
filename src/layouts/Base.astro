---
import { withBase } from '@/lib/url';
import '@/styles/global.css';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import Seo from '@/components/Seo.astro';
import TabBar from '@/components/TabBar.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '@/lib/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Page-level class on <main>. */
  class?: string;
}

const { class: cls, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/icons/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <Seo {...seo} />
    <ClientRouter fallback="swap" />
    <script is:inline>
      // Theme is resolved before first paint to avoid a flash. Explicit choice wins, then system preference.
      (function () {
        try {
          var stored = localStorage.getItem('ethereal:theme');
          var dark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col pb-20 md:pb-0">
    <a
      href="#main"
      class="btn btn-primary sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class:list={['flex-1', cls]} transition:animate="fade">
      <slot />
    </main>
    <Footer />
    <TabBar />
    <script>
      // Keep the chosen theme when the ClientRouter swaps <html> attributes during navigation.
      document.addEventListener('astro:before-swap', (e) => {
        const ev = e as Event & { newDocument: Document };
        ev.newDocument.documentElement.dataset.theme =
          document.documentElement.dataset.theme ?? 'light';
      });
      // The install prompt often fires before the settings island hydrates; keep it for later.
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        (window as unknown as { __installPrompt?: Event }).__installPrompt = e;
      });
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        const base = import.meta.env.BASE_URL.endsWith('/')
          ? import.meta.env.BASE_URL
          : `${import.meta.env.BASE_URL}/`;
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(`${base}sw.js`, { scope: base }).catch(() => undefined);
        });
      }
    </script>
  </body>
</html>
